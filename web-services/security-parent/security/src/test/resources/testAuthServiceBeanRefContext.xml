<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans-4.0.xsd" default-autowire="no">

    <bean class="datawave.configuration.spring.SpringContextProperties" autowire="no">
        <property name="scanBasePackages">
            <list>
                <value>datawave.webservice.config</value>
            </list>
        </property>
        <property name="sources">
            <list>
                <value>classpath*:datawave/configuration/spring/CDIBeanPostProcessor.xml</value>
                <value>classpath*:TestAuthServiceTestUsers.xml</value>
                <value>classpath*:TestRemoteServices.xml</value>
            </list>
        </property>
    </bean>
</beans>