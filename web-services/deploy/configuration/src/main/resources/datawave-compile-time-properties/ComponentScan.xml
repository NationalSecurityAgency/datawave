<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans-4.0.xsd
    http://www.springframework.org/schema/context
    http://www.springframework.org/schema/context/spring-context-4.0.xsd">

    <context:component-scan annotation-config="false" base-package="datawave.microservice.query.logic.config, datawave.microservice.query.lookup, datawave.microservice.query.mapreduce.config"/>

    <bean class="datawave.configuration.spring.CustomCommonAnnotationBeanPostProcessor">
        <property name="postConstructExcludeByRegex">
            <list value-type="java.lang.String">
                <value>datawave.webservice.*</value>
                <value>datawave.*remote</value>
                <value>datawave.security.authorization.remote.RemoteUserOperationsImpl</value>
            </list>
        </property>
        <property name="preDestroyExcludeByRegex">
            <list value-type="java.lang.String">
                <value>datawave.webservice.*</value>
                <value>datawave.*remote</value>
                <value>datawave.security.authorization.remote.RemoteUserOperationsImpl</value>
            </list>
        </property>
        <property name="processPropertiesExcludeByRegex">
            <list value-type="java.lang.String">
                <value>x.*</value>
            </list>
        </property>
    </bean>
</beans>
