<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:util="http://www.springframework.org/schema/util"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans-4.0.xsd
       http://www.springframework.org/schema/util
       http://www.springframework.org/schema/util/spring-util-4.0.xsd">

    <bean id="QueryMetricsWriterProperties" class="datawave.webservice.config.QueryMetricsWriterProperties">
        <property name="useRemoteService" value="${querymetric.remoteservice.enabled}"/>
        <property name="remoteProcessorThreads" value="${query.metrics.remoteProcessorThreads:4}"/>
        <property name="batchSize" value="${query.metrics.batchSize:100}"/>
        <property name="maxQueueSize" value="${query.metrics.maxQueueSize:250000}"/>
        <property name="maxLatencyMs" value="${query.metrics.maxLatencyMs:5000}"/>
        <property name="maxShutdownMs" value="${query.metrics.maxShutdownMs:30000}"/>
    </bean>

    <bean id="QueryMetricsTimelyProperties" class="datawave.webservice.config.QueryMetricsTimelyProperties">
        <property name="host" value="${query.metrics.timely.host}"/>
        <property name="port" value="${query.metrics.timely.port}"/>
        <property name="metricFieldTags">
            ${query.metrics.timely.metricFieldTags}
        </property>
    </bean>
</beans>