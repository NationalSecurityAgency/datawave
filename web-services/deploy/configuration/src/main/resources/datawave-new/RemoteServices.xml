<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:util="http://www.springframework.org/schema/util"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans-4.0.xsd
       http://www.springframework.org/schema/util
       http://www.springframework.org/schema/util/spring-util-4.0.xsd">

    <bean id="datawaveUserServiceFactory" class="datawave.security.authorization.DatawaveUserServiceFactory">
        <property name="activeService" value="${dw.security.activeService}"/>
        <property name="services">
            <util:map>
                <entry key="TEST" value-ref="testDatawaveUserService"/>
                <entry key="REMOTE" value-ref="remoteDatawaveUserService"/>
            </util:map>
        </property>
    </bean>

    <bean id="testDatawaveUserService" class="datawave.security.authorization.test.TestDatawaveUserService">
        <!-- testUsers are autowired from the WebserviceConfiguration class which reads from wildfly.yml -->
        <property name="testUsers" ref="testDatawaveUsers"/>
        <property name="activeDelegateService" value="${dw.testDatawaveUserService.activeDelegateService}"/>
        <property name="delegateServices">
            <util:map>
                <entry key="REMOTE" value-ref="remoteDatawaveUserService"/>
            </util:map>
        </property>
    </bean>

    <bean id="remoteDatawaveUserService" class="datawave.security.authorization.remote.RemoteDatawaveUserService">
        <property name="sslStores" ref="sslStores"/>
        <property name="config">
            <bean class="datawave.webservice.common.remote.RemoteHttpServiceProperties">
                <property name="serviceScheme" value="${dw.remoteDatawaveUserService.serviceScheme}"/>
                <property name="serviceHost" value="${dw.remoteDatawaveUserService.serviceHost}"/>
                <property name="servicePort" value="${dw.remoteDatawaveUserService.servicePort}"/>
            </bean>
        </property>
    </bean>

    <bean id="remoteQueryMetricService" class="datawave.webservice.query.remote.RemoteQueryMetricService">
        <property name="sslStores" ref="sslStores"/>
        <property name="config">
            <bean class="datawave.webservice.common.remote.RemoteHttpServiceProperties">
                <property name="serviceScheme" value="${dw.remoteQueryMetricService.serviceScheme}"/>
                <property name="serviceHost" value="${dw.remoteQueryMetricService.serviceHost}"/>
                <property name="servicePort" value="${dw.remoteQueryMetricService.servicePort}"/>
            </bean>
        </property>
        <property name="useConfiguredURIForRedirect" value="${dw.remoteQueryMetricService.useConfiguredURIForRedirect}"/>
    </bean>

    <bean id="remoteEdgeDictionary" class="datawave.webservice.edgedictionary.RemoteEdgeDictionary">
        <property name="config">
            <bean class="datawave.webservice.common.remote.RemoteHttpServiceProperties">
                <property name="serviceScheme" value="${dw.remoteDictionaryService.serviceScheme}"/>
                <property name="serviceHost" value="${dw.remoteDictionaryService.serviceHost}"/>
                <property name="servicePort" value="${dw.remoteDictionaryService.servicePort}"/>
            </bean>
        </property>
    </bean>

    <bean id="edgeDictionaryProvider" scope="prototype" class="datawave.webservice.edgedictionary.EdgeDictionaryProviderImpl">
        <property name="remoteEdgeDictionary" ref="remoteEdgeDictionary"/>
    </bean>

    <bean id="remoteDataDictionary" class="datawave.webservice.datadictionary.RemoteDataDictionary">
        <property name="sslStores" ref="sslStores"/>
        <property name="config">
            <bean class="datawave.webservice.common.remote.RemoteHttpServiceProperties">
                <property name="serviceScheme" value="${dw.remoteDictionaryService.serviceScheme}"/>
                <property name="serviceHost" value="${dw.remoteDictionaryService.serviceHost}"/>
                <property name="servicePort" value="${dw.remoteDictionaryService.servicePort}"/>
            </bean>
        </property>
    </bean>

    <bean id="auditServiceFactory" class="datawave.webservice.common.audit.AuditServiceFactory">
        <property name="activeService" value="${dw.audit.activeService}"/>
        <property name="services">
            <util:map>
                <entry key="NOOP" value-ref="noOpAuditor"/>
                <entry key="REMOTE" value-ref="remoteAuditor"/>
            </util:map>
        </property>
    </bean>

    <bean id="auditService" factory-bean="auditServiceFactory" factory-method="createService"/>

    <bean id="noOpAuditor" class="datawave.webservice.common.audit.NoOpAuditor"/>

    <bean id="remoteAuditor" class="datawave.webservice.common.audit.remote.RemoteAuditor">
        <property name="config">
            <bean class="datawave.webservice.common.remote.RemoteHttpServiceProperties">
                <property name="serviceScheme" value="${dw.remoteAuditorService.serviceScheme}"/>
                <property name="serviceHost" value="${dw.remoteAuditorService.serviceHost}"/>
                <property name="servicePort" value="${dw.remoteAuditorService.servicePort}"/>
            </bean>
        </property>
    </bean>

    <bean id="remoteStatsService" class="datawave.webservice.operations.remote.RemoteStatsService">
        <property name="sslStores" ref="sslStores"/>
        <property name="config">
            <bean class="datawave.webservice.common.remote.RemoteHttpServiceProperties">
                <property name="serviceScheme" value="${dw.remoteAccumuloService.serviceScheme}"/>
                <property name="serviceHost" value="${dw.remoteAccumuloService.serviceHost}"/>
                <property name="servicePort" value="${dw.remoteAccumuloService.servicePort}"/>
            </bean>
        </property>
    </bean>

    <bean id="remoteAdminService" class="datawave.webservice.operations.remote.RemoteAdminService">
        <property name="sslStores" ref="sslStores"/>
        <property name="config">
            <bean class="datawave.webservice.common.remote.RemoteHttpServiceProperties">
                <property name="serviceScheme" value="${dw.remoteAccumuloService.serviceScheme}"/>
                <property name="serviceHost" value="${dw.remoteAccumuloService.serviceHost}"/>
                <property name="servicePort" value="${dw.remoteAccumuloService.servicePort}"/>
            </bean>
        </property>
    </bean>

    <bean id="remoteLookupService" class="datawave.webservice.operations.remote.RemoteLookupService">
        <property name="sslStores" ref="sslStores"/>
        <property name="config">
            <bean class="datawave.webservice.common.remote.RemoteHttpServiceProperties">
                <property name="serviceScheme" value="${dw.remoteAccumuloService.serviceScheme}"/>
                <property name="serviceHost" value="${dw.remoteAccumuloService.serviceHost}"/>
                <property name="servicePort" value="${dw.remoteAccumuloService.servicePort}"/>
            </bean>
        </property>
    </bean>
</beans>