<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans-4.0.xsd">

    <bean id="metricsCDIProperties" class="datawave.metrics.MetricsCDIProperties">
        <property name="reportHost" value="${dw.metrics.reporter.host:localhost}"/>
        <property name="reportPort" value="${dw.metrics.reporter.port:54321}"/>
        <property name="reporterClass" value="${dw.metrics.reporter.class:datawave.metrics.TimelyMetricsReporterFactory}"/>
        <property name="reportInterval" value="${dw.metrics.reporter.report.interval.value:60}"/>
        <property name="reportIntervalTimeUnit" value="${dw.metrics.reporter.report.interval.units:SECONDS}"/>
    </bean>

</beans>
