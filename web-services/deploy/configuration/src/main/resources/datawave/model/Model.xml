<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans-4.0.xsd">

    <bean id="modelProperties" class="datawave.webservice.config.ModelProperties">
        <property name="defaultModelTableName" value="${table.name.metadata}"/>
        <property name="jqueryUri" value="/jquery.min.js"/>
        <property name="dataTablesUri" value="/jquery.dataTables.min.js"/>
        <property name="systemName" value="${cluster.name}"/>
    </bean>
</beans>