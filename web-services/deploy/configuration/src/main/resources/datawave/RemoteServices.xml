<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:util="http://www.springframework.org/schema/util"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans-4.0.xsd
       http://www.springframework.org/schema/util
       http://www.springframework.org/schema/util/spring-util-4.0.xsd">

    <!-- these values get substituted at compile time and then are used by other beans -->
    <bean class="org.springframework.beans.factory.config.PropertyPlaceholderConfigurer">
        <property name="properties">
            <props>
                <prop key="datawave.active-implementation.audit-service">${datawave.active-implementation.audit-service}</prop>
                <prop key="datawave.active-implementation.response-object-factory">${datawave.active-implementation.response-object-factory}</prop>
                <prop key="datawave.active-implementation.datawave-user-service">${datawave.active-implementation.datawave-user-service}</prop>
            </props>
        </property>
    </bean>

    <!-- The datawaveResourceFactory gets a bean from the applicationContext based on the requested type from property found in the environment -->
    <bean id="datawaveResourceFactory" class="datawave.webservice.DatawaveResourceFactory"/>

    <!-- based on property datawave.active-implementation.datawave-user-service -->
    <bean id="datawaveUserService" class="datawave.security.authorization.DatawaveUserService" factory-bean="datawaveResourceFactory" factory-method="datawaveUserService"/>

    <!-- based on property datawave.active-implementation.audit-service -->
    <bean id="auditService" class="datawave.webservice.common.audit.AuditService" factory-bean="datawaveResourceFactory" factory-method="auditService"/>

    <bean id="remoteDatawaveUserService" class="datawave.security.authorization.remote.RemoteDatawaveUserService" init-method="init">
        <property name="sslStores" ref="sslStores"/>
        <property name="objectMapperDecorator" ref="objectMapperDecorator"/>
        <property name="responseObjectFactory" ref="responseObjectFactory"/>
        <property name="executorService" ref="executorService"/>
        <property name="config">
            <bean class="datawave.webservice.common.remote.RemoteHttpServiceProperties">
                <property name="serviceScheme" value="${security.remoteuserservice.scheme}"/>
                <property name="serviceHost" value="${security.remoteuserservice.host}"/>
                <property name="servicePort" value="${security.remoteuserservice.port}"/>
            </bean>
        </property>
    </bean>

    <bean id="remoteQueryMetricService" class="datawave.metrics.remote.RemoteQueryMetricService" init-method="init">
        <property name="sslStores" ref="sslStores"/>
        <property name="objectMapperDecorator" ref="objectMapperDecorator"/>
        <property name="responseObjectFactory" ref="responseObjectFactory"/>
        <property name="executorService" ref="executorService"/>
        <property name="config">
            <bean class="datawave.webservice.common.remote.RemoteHttpServiceProperties">
                <property name="serviceScheme" value="${querymetric.remoteservice.scheme}"/>
                <property name="serviceHost" value="${querymetric.remoteservice.host}"/>
                <property name="servicePort" value="${querymetric.remoteservice.port}"/>
            </bean>
        </property>
        <property name="useConfiguredURIForRedirect" value="${querymetric.remoteservice.useConfiguredURIForRedirect}"/>
    </bean>

    <bean id="remoteEdgeDictionary" class="datawave.webservice.edgedictionary.RemoteEdgeDictionary" init-method="init">
        <property name="sslStores" ref="sslStores"/>
        <property name="objectMapperDecorator" ref="objectMapperDecorator"/>
        <property name="responseObjectFactory" ref="responseObjectFactory"/>
        <property name="executorService" ref="executorService"/>
        <property name="config">
            <bean class="datawave.webservice.common.remote.RemoteHttpServiceProperties">
                <property name="serviceScheme" value="${querymetric.remoteservice.scheme}"/>
                <property name="serviceHost" value="${querymetric.remoteservice.host}"/>
                <property name="servicePort" value="${querymetric.remoteservice.port}"/>
            </bean>
        </property>
    </bean>

    <bean id="edgeDictionaryProvider" scope="prototype" class="datawave.webservice.edgedictionary.EdgeDictionaryProviderImpl">
        <property name="remoteEdgeDictionary" ref="remoteEdgeDictionary"/>
    </bean>

    <bean id="remoteDataDictionary" class="datawave.webservice.datadictionary.RemoteDataDictionary" init-method="init">
        <property name="sslStores" ref="sslStores"/>
        <property name="objectMapperDecorator" ref="objectMapperDecorator"/>
        <property name="responseObjectFactory" ref="responseObjectFactory"/>
        <property name="executorService" ref="executorService"/>
        <property name="config">
            <bean class="datawave.webservice.common.remote.RemoteHttpServiceProperties">
                <property name="serviceScheme" value="${dictionary.remoteservice.scheme}"/>
                <property name="serviceHost" value="${dictionary.remoteservice.host}"/>
                <property name="servicePort" value="${dictionary.remoteservice.port}"/>
            </bean>
        </property>
    </bean>

    <bean id="noOpAuditor" class="datawave.webservice.common.audit.NoOpAuditor"/>

    <bean id="remoteAuditor" class="datawave.webservice.common.audit.remote.RemoteAuditor" init-method="init">
        <property name="sslStores" ref="sslStores"/>
        <property name="objectMapperDecorator" ref="objectMapperDecorator"/>
        <property name="responseObjectFactory" ref="responseObjectFactory"/>
        <property name="executorService" ref="executorService"/>
        <property name="config">
            <bean class="datawave.webservice.common.remote.RemoteHttpServiceProperties">
                <property name="serviceScheme" value="${auditing.remoteauditservice.scheme}"/>
                <property name="serviceHost" value="${auditing.remoteauditservice.host}"/>
                <property name="servicePort" value="${auditing.remoteauditservice.port}"/>
            </bean>
        </property>
    </bean>

    <bean id="remoteStatsService" class="datawave.webservice.operations.remote.RemoteStatsService" init-method="init">
        <property name="sslStores" ref="sslStores"/>
        <property name="objectMapperDecorator" ref="objectMapperDecorator"/>
        <property name="responseObjectFactory" ref="responseObjectFactory"/>
        <property name="executorService" ref="executorService"/>
        <property name="config">
            <bean class="datawave.webservice.common.remote.RemoteHttpServiceProperties">
                <property name="serviceScheme" value="${accumulo.remoteservice.scheme}"/>
                <property name="serviceHost" value="${accumulo.remoteservice.host}"/>
                <property name="servicePort" value="${accumulo.remoteservice.port}"/>
            </bean>
        </property>
    </bean>

    <bean id="remoteAdminService" class="datawave.webservice.operations.remote.RemoteAdminService" init-method="init">
        <property name="sslStores" ref="sslStores"/>
        <property name="objectMapperDecorator" ref="objectMapperDecorator"/>
        <property name="responseObjectFactory" ref="responseObjectFactory"/>
        <property name="executorService" ref="executorService"/>
        <property name="config">
            <bean class="datawave.webservice.common.remote.RemoteHttpServiceProperties">
                <property name="serviceScheme" value="${accumulo.remoteservice.scheme}"/>
                <property name="serviceHost" value="${accumulo.remoteservice.host}"/>
                <property name="servicePort" value="${accumulo.remoteservice.port}"/>
            </bean>
        </property>
    </bean>

    <bean id="remoteLookupService" class="datawave.webservice.operations.remote.RemoteLookupService" init-method="init">
        <property name="sslStores" ref="sslStores"/>
        <property name="objectMapperDecorator" ref="objectMapperDecorator"/>
        <property name="responseObjectFactory" ref="responseObjectFactory"/>
        <property name="executorService" ref="executorService"/>
        <property name="config">
            <bean class="datawave.webservice.common.remote.RemoteHttpServiceProperties">
                <property name="serviceScheme" value="${accumulo.remoteservice.scheme}"/>
                <property name="serviceHost" value="${accumulo.remoteservice.host}"/>
                <property name="servicePort" value="${accumulo.remoteservice.port}"/>
            </bean>
        </property>
    </bean>

    <bean id="objectMapperDecorator" class="datawave.webservice.common.json.DefaultMapperDecorator"/>

    <bean id="executorService" class="java.util.concurrent.ThreadPoolExecutor" destroy-method="shutdown">
        <constructor-arg name="corePoolSize" value="10"/>
        <constructor-arg name="maximumPoolSize" value="100"/>
        <constructor-arg name="keepAliveTime" value="60"/>
        <constructor-arg name="unit" value="SECONDS"/>
        <constructor-arg name="workQueue">
            <bean class="java.util.concurrent.ArrayBlockingQueue">
                <constructor-arg name="capacity" value="100"/>
            </bean>
        </constructor-arg>
    </bean>
</beans>