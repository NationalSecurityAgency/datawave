<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans-4.0.xsd">

    <bean id="metricsCDIProperties" class="datawave.metrics.MetricsCDIProperties">
        <property name="reportHost" value="${metrics.reporter.host}"/>
        <property name="reportPort" value="${metrics.reporter.port}"/>
        <property name="reporterClass" value="${metrics.reporter.class}"/>
    </bean>
</beans>
