<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans-4.0.xsd">

    <bean id="sslStoresProducer" class="datawave.security.system.SSLStoresProducer">
        <property name="keyStoreType" value="${KEYSTORE_TYPE}"/>
        <property name="keyStoreUrl" value="file://${KEYSTORE}"/>
        <property name="keyStorePassword" value="${KEYSTORE_PASSWORD}"/>
        <property name="trustStoreType" value="${TRUSTSTORE_TYPE}"/>
        <property name="trustStoreUrl" value="file://${TRUSTSTORE}"/>
        <property name="trustStorePassword" value="${TRUSTSTORE_PASSWORD}"/>
    </bean>

    <bean id="sslStores" factory-bean="sslStoresProducer" factory-method="produceSSlStores"/>
</beans>