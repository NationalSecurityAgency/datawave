<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans-4.0.xsd" default-autowire="no">

    <bean class="datawave.configuration.spring.SpringContextProperties" autowire="no">
        <property name="scanBasePackages">
            <list>
                <value>datawave.webservice.config</value>
                <value>datawave.microservice.config.marking</value>
                <value>datawave.microservice.query.edge.config</value>
                <value>datawave.microservice.query.logic.config</value>
            </list>
        </property>
        <property name="sources">
            <list>
                <value>classpath*:datawave/annotation/AnnotationManagerFactory.xml</value>
                <value>classpath*:datawave/configuration/spring/CDIBeanPostProcessor.xml</value>
                <value>classpath*:datawave/marking/MarkingFunctionsContext.xml</value>
                <value>classpath*:datawave/metadata/MetadataHelperContext.xml</value>
                <value>classpath*:datawave/metadata/MetadataHelperCacheListenerContext.xml</value>
                <value>classpath*:datawave/modification/ModificationServices.xml</value>
                <value>classpath*:datawave/query/CachedResults*.xml</value>
                <value>classpath*:datawave/query/QueryExpiration.xml</value>
                <value>classpath*:datawave/query/QueryLimiterFactory.xml</value>
                <value>classpath*:datawave/query/QueryMetricsWriter.xml</value>
                <value>classpath*:datawave/security/TestDatawaveUserServiceConfiguration.xml</value>
                <value>classpath*:org/apache/accumulo/operations/LookupBean.xml</value>
                <value>classpath*:CacheContext.xml</value>
                <value>classpath*:QueryLogicFactory.xml</value>
                <value>classpath*:EdgeQueryLogicFactory.xml</value>
                <value>classpath*:KeywordExtractionQueryLogicFactory.xml</value>
                <value>classpath*:SSDeepQueryLogicFactory.xml</value>
            </list>
        </property>
    </bean>
</beans>
