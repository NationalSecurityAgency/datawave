<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:util="http://www.springframework.org/schema/util"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-4.0.xsd
                            http://www.springframework.org/schema/util http://www.springframework.org/schema/util/spring-util-4.0.xsd">
    
	<!-- Database properties are retrieved from the database.properties file but can be overridden by system properties -->
	<bean id="propertyPlaceholderConfigurer" class="org.springframework.beans.factory.config.PropertyPlaceholderConfigurer">
		<property name="location" value="classpath:database.properties"/>
		<property name="systemPropertiesModeName" value="SYSTEM_PROPERTIES_MODE_OVERRIDE"/>
	</bean>

	<bean id="IdentityLogicMap" class="org.springframework.beans.factory.config.MapFactoryBean">
		<property name="sourceMap">
			<map>
				<entry key="UserQueryLogic" value="UserQueryLogic"/>
				<entry key="AdminQueryLogic" value="AdminQueryLogic"/>
			</map>
		</property>
	</bean>

	<bean id="ExpandedLogicMap" parent="IdentityLogicMap" class="org.springframework.beans.factory.config.MapFactoryBean">
		<property name="sourceMap">
			<map merge="true">
				<entry key="AdministratorQueryLogic" value="AdminQueryLogic"/>
			</map>
		</property>
	</bean>

	<bean id="AdminQueryLogic" class="datawave.webservice.query.logic.TestQueryLogic">
		<property name="logicName" value="Admin logic"/>
		<property name="requiredRoles" ref="adminRoles" />
	</bean>

	<bean id="UserQueryLogic" class="datawave.webservice.query.logic.TestQueryLogic">
		<property name="logicName" value="User logic"/>
		<property name="requiredRoles" ref="userRoles"/>
	</bean>

	<!-- Admin is the set of (admin) -->
	<util:set id="adminRoles">
		<value>admin</value>
	</util:set>

	<!-- User is the set of (user) -->
	<util:set id="userRoles">
		<value>user</value>
	</util:set>

	<bean id="queryLogicFactoryProperties" scope="prototype" class="datawave.microservice.query.logic.config.QueryLogicFactoryProperties">
		<property name="queryLogicsByName" ref="IdentityLogicMap"/>
		<property name="maxPageSize" value="12345"/>
		<property name="pageByteTrigger" value="123456"/>
	</bean>

</beans>
